# Copy to .env and adjust. Nothing here requires an external API key.

# --- Database (docker-compose db service publishes 127.0.0.1:5432)
POSTGRES_USER=bpi
POSTGRES_PASSWORD=bpi_password
POSTGRES_DB=bpi
DATABASE_URL=postgresql+psycopg://bpi:bpi_password@localhost:5432/bpi

# --- Security: CHANGE THIS (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-this-secret-key-in-production-please
ACCESS_TOKEN_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage (uploaded originals are content-addressed by SHA-256)
DATA_DIR=./data
MAX_UPLOAD_MB=50

# --- OCR (Windows: point to tesseract.exe if it is not on PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=eng+hin

# --- Chunking
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=120

# --- Embeddings: sentence_transformers | ollama | hashing (hashing = offline test embedder, not semantic)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
# Alternative via Ollama:  EMBEDDING_PROVIDER=ollama  EMBEDDING_MODEL=bge-m3  EMBEDDING_DIM=1024

# --- Cross-encoder reranker: cross_encoder | none
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Local LLM (Ollama). Low-RAM alternatives: qwen2.5:3b, phi3:mini, gemma2:2b. 16 GB RAM+: llama3.1:8b, qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.1

# --- Retrieval defaults (also editable at runtime in Settings)
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
DENSE_SIMILARITY_THRESHOLD=0.2
RERANK_SCORE_THRESHOLD=-2.0
RRF_K=60
CITATION_SUPPORT_THRESHOLD=0.35

# Offline operation after models are cached:
# HF_HUB_OFFLINE=1
